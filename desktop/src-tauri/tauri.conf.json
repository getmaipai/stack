{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MaiPai Stack",
  "version": "0.1.0",
  "identifier": "com.maipai.stack",
  "build": {
    "beforeDevCommand": "bun --cwd ../backend dev",
    "beforeBuildCommand": "bun --cwd ../frontend build",
    "devUrl": "http://127.0.0.1:8770",
    "frontendDist": "../../frontend/dist"
  },
  "app": { "withGlobalTauri": true, "windows": [], "security": { "csp": null }, "trayIcon": { "iconPath": "icons/maipai-stack-icon.png", "tooltip": "MaiPai Stack" } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/maipai-stack-icon.png"] }
}
