{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/stt-wire-event.schema.json",
  "title": "SttWireEvent",
  "description": "One JSON text frame from the server on the live speech session (WS /v1/audio/transcriptions/stream on the Stack, WS /api/stt/stream on Home): the contract of spec/voice/ts/sttTypes.ts. The client sends binary frames, each a little-endian Float32Array of 16 kHz mono samples with no envelope, and may send one text frame {\"t\":\"end\"} to flush the utterance in progress; the server never sends binary frames back.",
  "oneOf": [
    { "type": "object", "additionalProperties": false, "required": ["t"], "properties": { "t": { "const": "ready" } } },
    { "type": "object", "additionalProperties": false, "required": ["t", "speaking", "rms"], "properties": { "t": { "const": "vad" }, "speaking": { "type": "boolean" }, "rms": { "type": "number", "minimum": 0 } } },
    { "type": "object", "additionalProperties": false, "required": ["t", "v"], "properties": { "t": { "const": "partial" }, "v": { "type": "string" } } },
    { "type": "object", "additionalProperties": false, "required": ["t", "v"], "properties": { "t": { "const": "final" }, "v": { "type": "string", "minLength": 1 } } },
    { "type": "object", "additionalProperties": false, "required": ["t"], "properties": { "t": { "const": "no_speech" } } },
    { "type": "object", "additionalProperties": false, "required": ["t", "v"], "properties": { "t": { "const": "error" }, "v": { "type": "string", "minLength": 1 } } }
  ]
}
