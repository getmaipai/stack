{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/stack-event.schema.json",
  "title": "StackEvent",
  "description": "One envelope on the Stack's event feed (GET /stack/v1/events, server-sent). `seq` is the replay cursor a subscriber sends back as Last-Event-Id. The ten ids and what each `data` carries are fixed here; Home's notification bridge maps them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "at", "seq", "data"],
  "properties": {
    "id": {
      "type": "string",
      "enum": ["role.state", "engine.state", "pressure", "job.progress", "job.done", "model.installed", "update.available", "update.applied", "update.failed", "health.changed"]
    },
    "at": { "type": "string", "format": "date-time" },
    "seq": { "type": "integer", "minimum": 1 },
    "data": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "id": { "const": "role.state" } } }, "then": { "properties": { "data": { "type": "object", "required": ["role", "state", "since"], "properties": { "role": { "type": "string" }, "state": { "type": "string", "enum": ["notInstalled", "installed", "loaded", "ready", "offline"] }, "since": { "type": "string", "format": "date-time" }, "reason": { "type": "string" } } } } } },
    { "if": { "properties": { "id": { "const": "engine.state" } } }, "then": { "properties": { "data": { "type": "object", "required": ["engine", "state"], "properties": { "engine": { "type": "string" }, "state": { "type": "string", "enum": ["installed", "loading", "ready", "offline", "stopped"] }, "reason": { "type": "string" } } } } } },
    { "if": { "properties": { "id": { "const": "pressure" } } }, "then": { "properties": { "data": { "type": "object", "required": ["pressure"], "properties": { "pressure": { "type": "string", "enum": ["normal", "warn", "critical"] }, "free_memory_bytes": { "type": "integer", "minimum": 0 }, "floor_bytes": { "type": "integer", "minimum": 0 }, "available_percent": { "type": "number", "minimum": 0, "maximum": 100 }, "reason": { "type": "string" }, "id": { "type": "string" } } } } } },
    { "if": { "properties": { "id": { "const": "job.progress" } } }, "then": { "properties": { "data": { "type": "object", "required": ["job", "kind", "state", "percent", "completed_bytes", "total_bytes", "status"], "properties": { "job": { "type": "string" }, "kind": { "type": "string" }, "state": { "type": "string", "enum": ["queued", "running", "done", "failed", "cancelled"] }, "percent": { "type": "integer", "minimum": 0, "maximum": 100 }, "completed_bytes": { "type": "integer", "minimum": 0 }, "total_bytes": { "type": "integer", "minimum": 0 }, "status": { "type": "string" } } } } } },
    { "if": { "properties": { "id": { "const": "job.done" } } }, "then": { "properties": { "data": { "type": "object", "required": ["job", "kind", "ok"], "properties": { "job": { "type": "string" }, "kind": { "type": "string" }, "ok": { "type": "boolean" }, "reason": { "type": ["string", "null"] } } } } } },
    { "if": { "properties": { "id": { "const": "model.installed" } } }, "then": { "properties": { "data": { "type": "object", "required": ["model"], "properties": { "model": { "type": "string" }, "path": { "type": ["string", "null"] }, "removed": { "type": "boolean" } } } } } },
    { "if": { "properties": { "id": { "const": "update.available" } } }, "then": { "properties": { "data": { "type": "object", "required": ["kind", "name", "available"], "properties": { "kind": { "type": "string", "enum": ["engine", "model"] }, "name": { "type": "string" }, "installed": { "type": ["string", "null"] }, "available": { "type": "string" } } } } } },
    { "if": { "properties": { "id": { "const": "update.applied" } } }, "then": { "properties": { "data": { "type": "object", "required": ["kind", "name", "tag"], "properties": { "kind": { "type": "string", "enum": ["engine", "model"] }, "name": { "type": "string" }, "tag": { "type": "string" } } } } } },
    { "if": { "properties": { "id": { "const": "update.failed" } } }, "then": { "properties": { "data": { "type": "object", "required": ["kind", "reason"], "properties": { "kind": { "type": "string", "enum": ["engine", "model"] }, "name": { "type": "string" }, "reason": { "type": "string" } } } } } },
    { "if": { "properties": { "id": { "const": "health.changed" } } }, "then": { "properties": { "data": { "type": "object", "required": ["code", "severity", "title", "open"], "properties": { "code": { "type": "string" }, "severity": { "type": "string", "enum": ["critical", "error", "warning"] }, "title": { "type": "string" }, "open": { "type": "boolean" } } } } } }
  ]
}
