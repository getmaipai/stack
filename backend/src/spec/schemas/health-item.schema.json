{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/shared/spec/schemas/health-item.schema.json",
  "title": "HealthItem",
  "description": "One problem on the Stack's health list (GET /stack/v1/health): a stable code Home keys its Repairs list on, a severity, the sentence a person reads, when it opened, the cause, and at most one fix. Home renders the fix's label and calls POST /stack/v1/health/{code}/fix.",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "severity", "title", "text", "since", "cause"],
  "properties": {
    "code": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$", "description": "Stable and unique per condition, `engine.crashed.chat`, `memory-pressure-warn`." },
    "severity": { "type": "string", "enum": ["critical", "error", "warning"] },
    "title": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "since": { "type": "string", "format": "date-time" },
    "cause": { "type": "string", "minLength": 1 },
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "action"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "enum": ["restart_engine", "free_memory", "retry_download", "rollback_update", "reinstall_engine", "reinstall_model"] }
      }
    }
  }
}
