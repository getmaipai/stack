{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/kit/*": ["./node_modules/@maipai/ui/src/*"],
      "@/elements/*": ["./node_modules/@maipai/ui/src/elements/*"],
      "@/primitives/*": ["./node_modules/@maipai/ui/src/primitives/*"],
      "@/ui/*": ["./node_modules/@maipai/ui/src/ui/*"],
      "@/dashboard/*": ["./node_modules/@maipai/ui/src/dashboard/*"]
    }
  },
  "include": ["src"]
}
