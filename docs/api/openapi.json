                            "enum": [
                              "chat",
                              "coding",
                              "judge",
                              "router",
                              "embed",
                              "rerank",
                              "vision",
                              "stt",
                              "tts",
                              "wakeword",
                              "image",
                              "video",
                              "music"
                            ]
                          }
                        },
                        "onDemand": {
                          "type": "array",
