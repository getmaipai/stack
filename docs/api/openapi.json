                            "type": "string",
                            "enum": [
                              "chat",
                              "coding",
                              "judge",
                              "router",
                              "embed",
                              "rerank",
                              "vision",
                              "stt",
                              "tts",
                              "wakeword",
                              "image",
                              "video",
                              "music"
                            ]
                          }
                        },
                        "installedOnly": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "chat",
                              "coding",
                              "judge",
                              "router",
                              "embed",
                              "rerank",
                              "vision",
                              "stt",
                              "tts",
                              "wakeword",
                              "image",
                              "video",
                              "music"
                            ]
                          }
                        },
                        "notAvailable": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "chat",
                              "coding",
                              "judge",
                              "router",
                              "embed",
                              "rerank",
                              "vision",
                              "stt",
                              "tts",
                              "wakeword",
                              "image",
                              "video",
                              "music"
                            ]
                          }
                        }
                      },
                      "required": [
                        "id",
                        "label",
                        "minUnifiedGb",
                        "minVramGb",
                        "resident",
                        "onDemand",
                        "installedOnly",
                        "notAvailable"
                      ]
