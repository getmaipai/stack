    "/stack/v1/engines": {
      "get": {
        "tags": [
          "Engines"
        ],
        "summary": "Pinned engine builds",
        "responses": {
          "200": {
            "description": "Pinned builds and their local installation state.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "engines": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "platform": {
                            "type": "string",
                            "enum": [
                              "darwin",
                              "win32"
                            ]
                          },
                          "arch": {
                            "type": "string",
                            "enum": [
                              "arm64",
                              "x64"
                            ]
                          },
                          "verified": {
                            "type": "boolean"
                          },
                          "installed": {
                            "type": "boolean"
                          },
                          "matchesThisMachine": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "label",
                          "platform",
                          "arch",
                          "verified",
                          "installed",
                          "matchesThisMachine"
                        ]
                      }
                    }
                  },
                  "required": [
                    "engines"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/stack/v1/roles": {
      "get": {
        "tags": [
          "Roles"
        ],
        "summary": "Declared capability roles",
        "responses": {
          "200": {
            "description": "Every declared role and its current state.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "roles": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "wire": {
                            "type": "string",
                            "enum": [
                              "chat",
                              "embeddings",
                              "rerank",
                              "transcription",
                              "speech",
                              "job"
                            ]
                          },
                          "residency": {
                            "type": "string",
                            "enum": [
                              "resident",
                              "jit",
                              "installed"
                            ]
                          },
                          "endpoints": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "quality": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "fast",
                                "everyday",
                                "best"
                              ]
                            }
                          },
                          "description": {
                            "type": "string"
                          },
                          "sharesModelWith": {
                            "type": "string",
                            "enum": [
                              "chat",
                              "coding",
                              "judge",
                              "router",
                              "embed",
                              "rerank",
                              "vision",
                              "stt",
                              "tts",
                              "wakeword",
                              "image",
                              "video",
                              "music"
                            ]
                          },
                          "id": {
                            "type": "string",
                            "enum": [
                              "chat",
                              "coding",
                              "judge",
                              "router",
                              "embed",
                              "rerank",
                              "vision",
                              "stt",
                              "tts",
                              "wakeword",
                              "image",
                              "video",
                              "music"
                            ]
                          },
                          "state": {
                            "type": "string",
                            "enum": [
                              "notInstalled",
                              "installed",
                              "loading",
                              "ready",
                              "busy",
                              "stopped",
                              "offline"
                            ]
                          },
                          "reason": {
                            "type": "string",
                            "nullable": true
                          }
                        },
                        "required": [
                          "wire",
                          "residency",
                          "endpoints",
                          "quality",
                          "description",
                          "id",
                          "state",
                          "reason"
                        ]
                      }
                    }
                  },
                  "required": [
                    "roles"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "tags": [
          "Inference"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string"
                        },
                        "content": {
                          "nullable": true
                        }
                      },
                      "required": [
                        "role"
                      ],
                      "additionalProperties": {
                        "nullable": true
                      }
                    }
                  },
                  "stream": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "model",
                  "messages"
                ],
                "additionalProperties": {
                  "nullable": true
                }
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Unknown role or model.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "roles": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "error",
                    "roles"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "No engine is bound to the role.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string"
                    },
                    "offline_reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "role",
                    "state",
                    "offline_reason"
                  ]
                }
              }
            }
          }
        }
      }
    },
