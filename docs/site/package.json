{
  "name": "maipai-stack-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "bun scripts/sync-shots.ts && NEXT_TELEMETRY_DISABLED=1 next dev -p 3020",
    "build": "bun scripts/sync-shots.ts && NEXT_TELEMETRY_DISABLED=1 next build",
    "serve": "bunx --bun serve out -l 3021",
    "types:check": "next typegen && tsc --noEmit",
    "shots": "bun scripts/sync-shots.ts"
  },
  "dependencies": {
    "fumadocs-core": "16.17.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.3",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
